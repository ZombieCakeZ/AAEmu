<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>AAEmu.PacketProxy</RootNamespace>
    <AssemblyName>aaemu-packetproxy</AssemblyName>
    <Nullable>enable</Nullable>
    <NoWarn>CA1031</NoWarn>

    <!-- Single-file self-contained publish defaults so `dotnet publish -r win-x64`
         produces one drop-in exe. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifiers>win-x64;linux-x64</RuntimeIdentifiers>
  </PropertyGroup>

</Project>
